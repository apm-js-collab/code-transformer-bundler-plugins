{
    "name": "@apm-js-collab/code-transformer-bundler-plugins",
    "version": "0.1.0",
    "type": "module",
    "description": "A universal plugin that uses @apm-js-collab/code-transformer to instrument JavaScript code at build time",
    "exports": {
        "./rollup": {
            "import": "./dist/rollup.mjs",
            "require": "./dist/rollup.js",
            "types": "./dist/rollup.d.ts"
        },
        "./webpack": {
            "import": "./dist/webpack.mjs",
            "require": "./dist/webpack.js",
            "types": "./dist/webpack.d.ts"
        },
        "./vite": {
            "import": "./dist/vite.mjs",
            "require": "./dist/vite.js",
            "types": "./dist/vite.d.ts"
        },
        "./esbuild": {
            "import": "./dist/esbuild.mjs",
            "require": "./dist/esbuild.js",
            "types": "./dist/esbuild.d.ts"
        }
    },
    "scripts": {
        "build": "rollup -c",
        "dev": "rollup -c -w",
        "test": "vitest run",
        "prepublishOnly": "npm run build",
        "example": "node examples/basic/build.js"
    },
    "keywords": [
        "unplugin",
        "rollup",
        "webpack",
        "vite",
        "esbuild",
        "plugin",
        "instrumentation",
        "apm",
        "tracing",
        "transform"
    ],
    "license": "MIT",
    "files": [
        "dist"
    ],
    "peerDependencies": {
        "esbuild": "*",
        "rollup": "^3.0.0 || ^4.0.0",
        "vite": "^3.0.0 || ^4.0.0 || ^5.0.0",
        "webpack": "^4.0.0 || ^5.0.0"
    },
    "peerDependenciesMeta": {
        "rollup": {
            "optional": true
        },
        "webpack": {
            "optional": true
        },
        "vite": {
            "optional": true
        },
        "esbuild": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@apm-js-collab/code-transformer": "^0.3.0",
        "module-details-from-path": "^1.0.4",
        "unplugin": "^2.3.5"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-typescript": "^12.1.3",
        "@types/node": "^20.10.4",
        "esbuild": "^0.25.5",
        "rollup": "^4.9.1",
        "tslib": "^2.6.2",
        "typescript": "^5.3.3",
        "vite": "^7.0.0",
        "vitest": "^3.2.4",
        "webpack": "^5.99.9"
    },
    "engines": {
        "node": ">=16.0.0"
    },
    "volta": {
        "node": "22.17.0"
    }
}