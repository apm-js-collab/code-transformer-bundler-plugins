{
    "name": "rollup-plugin-code-transformer",
    "version": "1.0.0",
    "type": "module",
    "description": "A Rollup plugin that uses @apm-js-collab/code-transformer to instrument JavaScript code at build time",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "rollup -c",
        "dev": "rollup -c -w",
        "test": "vitest run",
        "prepublishOnly": "npm run build",
        "example": "node examples/basic/build.js"
    },
    "keywords": [
        "rollup",
        "plugin",
        "orchestrion",
        "instrumentation",
        "apm",
        "tracing",
        "transform"
    ],
    "author": "Your Name",
    "license": "MIT",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "peerDependencies": {
        "rollup": "^3.0.0 || ^4.0.0"
    },
    "dependencies": {
        "@apm-js-collab/code-transformer": "^0.3.0",
        "@rollup/pluginutils": "^5.1.0",
        "module-details-from-path": "^1.0.4"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^25.0.7",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-typescript": "^11.1.5",
        "@types/node": "^20.10.4",
        "rollup": "^4.9.1",
        "tslib": "^2.6.2",
        "typescript": "^5.3.3",
        "vitest": "^1.1.0"
    },
    "engines": {
        "node": ">=16.0.0"
    }
}