{
    "name": "@apm-js-collab/code-transformer-bundler-plugins",
    "version": "0.2.2",
    "type": "module",
    "description": "A universal plugin that uses '@apm-js-collab/code-transformer' to instrument JavaScript code at build time",
    "keywords": [
        "rollup",
        "webpack",
        "vite",
        "esbuild",
        "turbopack",
        "loader",
        "plugin",
        "instrumentation",
        "apm",
        "tracing",
        "transform"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/apm-js-collab/code-transformer-bundler-plugins"
    },
    "scripts": {
        "build": "tsc && tsc --module commonjs --outDir dist/cjs",
        "test": "vitest run"
    },
    "license": "MIT",
    "exports": {
        "./rollup": {
            "import": {
                "types": "./dist/esm/rollup.d.ts",
                "default": "./dist/esm/rollup.mjs"
            },
            "require": {
                "types": "./dist/cjs/rollup.d.ts",
                "default": "./dist/cjs/rollup.js"
            }
        },
        "./webpack": {
            "import": {
                "types": "./dist/esm/webpack.d.ts",
                "default": "./dist/esm/webpack.mjs"
            },
            "require": {
                "types": "./dist/cjs/webpack.d.ts",
                "default": "./dist/cjs/webpack.js"
            }
        },
        "./vite": {
            "import": {
                "types": "./dist/esm/vite.d.ts",
                "default": "./dist/esm/vite.mjs"
            },
            "require": {
                "types": "./dist/cjs/vite.d.ts",
                "default": "./dist/cjs/vite.js"
            }
        },
        "./esbuild": {
            "import": {
                "types": "./dist/esm/esbuild.d.ts",
                "default": "./dist/esm/esbuild.mjs"
            },
            "require": {
                "types": "./dist/cjs/esbuild.d.ts",
                "default": "./dist/cjs/esbuild.js"
            }
        },
        "./webpack-loader": {
            "types": "./dist/cjs/webpack-loader.d.cts",
            "default": "./dist/cjs/webpack-loader.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@apm-js-collab/code-transformer": "^0.13.0",
        "module-details-from-path": "^1.0.4",
        "unplugin": "^2.3.5"
    },
    "devDependencies": {
        "@types/node": "^20.10.4",
        "esbuild": "^0.25.5",
        "rollup": "^4.9.1",
        "tslib": "^2.6.2",
        "typescript": "^5.3.3",
        "vite": "^7.0.0",
        "vitest": "^3.2.4",
        "webpack": "^5.99.9"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "volta": {
        "node": "22.17.0"
    }
}
